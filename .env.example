# Copy to .env.local for local dev, and set the same keys in Vercel → Project → Settings → Environment Variables.
# The enquiry form works without these (it falls back to a mailto: link); set them to receive enquiries by email.

# Resend API key (https://resend.com → API Keys). Free tier is fine.
RESEND_API_KEY=

# Where enquiries are delivered.
ENQUIRY_TO=info@yusufucuz.com

# Verified sender. Use onboarding@resend.dev to test; switch to your own
# domain (e.g. "Yusuf Ucuz <enquiries@yusufucuz.com>") after verifying it in Resend.
ENQUIRY_FROM=Yusuf Ucuz <onboarding@resend.dev>
