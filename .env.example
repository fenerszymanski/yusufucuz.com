# Set these in Vercel → Project → Settings → Environment Variables (and .env.local for local dev).
# The enquiry form works without them (it falls back to a mailto: link); set them to
# receive enquiries via Wix Forms + Yusuf's existing Wix email automation.

# Wix account API key (same one BerlinWalk uses). Account-level; the site is chosen by WIX_SITE_ID.
WIX_API_KEY=

# Which Wix site + form to submit to. Defaults (in code) reuse BerlinWalk's private-tour form.
WIX_SITE_ID=12ee5ea0-70a7-492f-8020-ffb27cbb630f
WIX_FORM_ID=5c5da80a-d838-49f6-b725-1a15c9838bc9
